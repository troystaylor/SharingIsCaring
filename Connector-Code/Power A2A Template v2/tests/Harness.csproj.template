<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Offline test harness for script.csx. Run it with Run-Tests.ps1, which builds in a temporary folder and
    restores only from your local NuGet cache. It never contacts nuget.org.

    The connector runtime is .NET Standard 2.0 with C# 7.3 features, so this project turns off the modern defaults
    that would let syntax compile here and fail after deployment.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>7.3</LangVersion>
    <UseAppHost>false</UseAppHost>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

</Project>
