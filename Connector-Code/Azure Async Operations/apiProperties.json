        "connectionParameters": {
            "token": {
                "type": "oauthSetting",
                "oAuthSettings": {
                    "identityProvider": "aad",
                    "clientId": "[YOUR_CLIENT_ID]",
                    "scopes": [
                        "https://management.azure.com/.default"
                    ],
                    "redirectMode": "Global",
                    "redirectUrl": "[YOUR_REDIRECT_URL]",
