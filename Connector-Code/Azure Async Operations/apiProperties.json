                            "value": "https://login.microsoftonline.com"
                        },
                        "tenantId": {
                            "value": "common"
                        },
                        "resourceUri": {
                            "value": "https://management.azure.com"
                        },
                        "enableOnbehalfOfLogin": {
                            "value": "false"
                        }
                    }
                }
            }
        },
        "iconBrandColor": "#0078D4",
