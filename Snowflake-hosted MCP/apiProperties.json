{
    "properties": {
        "connectionParameters": {
            "token": {
                "type": "oauthSetting",
                "oAuthSettings": {
                    "identityProvider": "oauth2",
                    "clientId": "YOUR_OAUTH_CLIENT_ID",
                    "clientSecret": "YOUR_OAUTH_CLIENT_SECRET",
                    "scopes": [
                        "session:role:all",
                        "refresh_token"
                    ],
                    "redirectMode": "GlobalPerConnector",
                    "redirectUrl": "https://global.consent.azure-apim.net/redirect/UNIQUE_IDENTIFIER_FOR_THIS_ENVIRONMENT",
                    "properties": {
                        "IsFirstParty": "False",
                        "IsOnbehalfofLoginSupported": false
                    },
                    "customParameters": {
                        "AuthorizationUrl": {
                            "value": "https://YOUR-ORG-YOUR-ACCOUNT.snowflakecomputing.com/oauth/authorize"
                        },
                        "TokenUrl": {
                            "value": "https://YOUR-ORG-YOUR-ACCOUNT.snowflakecomputing.com/oauth/token-request"
                        },
                        "RefreshUrl": {
                            "value": "https://YOUR-ORG-YOUR-ACCOUNT.snowflakecomputing.com/oauth/token-request"
                        }
                    }
                },
                "uiDefinition": {
                    "displayName": "Snowflake OAuth",
                    "description": "Sign in to Snowflake to access the MCP server.",
                    "constraints": {
                        "required": "true",
                        "hidden": "false"
                    }
                }
            }
        },
        "policyTemplateInstances": [],
        "iconBrandColor": "#29B5E8",
