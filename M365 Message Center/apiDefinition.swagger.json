{
  "swagger": "2.0",
  "info": {
    "title": "M365 Message Center",
    "description": "Read Microsoft 365 Message Center posts with the Microsoft Graph service communications API. List and search upcoming changes, get a post's full text, list attachments, and mark posts read, archived or favorited. Includes MCP support for Copilot Studio agents.",
    "version": "1.0",
    "contact": {
      "name": "Troy Taylor",
      "email": "troy@troystaylor.com",
      "url": "https://github.com/troystaylor"
    }
  },
  "host": "graph.microsoft.com",
  "basePath": "/v1.0",
  "schemes": [
    "https"
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "paths": {
    "/admin/serviceAnnouncement/messages": {
      "get": {
        "summary": "List Message Center Posts",
        "description": "List Message Center posts for your tenant, most recently changed first, with a short summary of each. Filter by service, category, severity, major changes, modified date or action deadline, or search by keyword. One call scans up to 500 posts.",
        "operationId": "ListMessages",
        "parameters": [
          {
            "name": "service",
            "in": "query",
            "description": "Affected service name exactly as Message Center lists it, for example Microsoft Teams, Exchange Online or SharePoint Online.",
            "required": false,
            "type": "string",
            "x-ms-summary": "Service"
          },
          {
            "name": "category",
            "in": "query",
            "description": "Plan for change, Prevent or fix issue, or Stay informed.",
            "required": false,
            "type": "string",
            "enum": [
              "planForChange",
              "preventOrFixIssue",
              "stayInformed"
            ],
            "x-ms-summary": "Category"
          },
          {
            "name": "severity",
            "in": "query",
            "description": "The severity of the post.",
            "required": false,
            "type": "string",
            "enum": [
              "normal",
              "high",
              "critical"
            ],
            "x-ms-summary": "Severity"
          },
          {
            "name": "majorChangeOnly",
            "in": "query",
            "description": "Return only posts marked as a major change.",
            "required": false,
            "type": "boolean",
            "default": false,
            "x-ms-summary": "Major Changes Only"
          },
          {
            "name": "modifiedSince",
            "in": "query",
            "description": "Only posts published or updated on or after this date or date-time, for example 2026-11-01.",
            "required": false,
            "type": "string",
            "x-ms-summary": "Modified Since"
          },
          {
            "name": "actionDueBefore",
            "in": "query",
            "description": "Only posts with an action-required deadline between now and this date, for example 2026-12-31. Results are sorted soonest first.",
            "required": false,
            "type": "string",
            "x-ms-summary": "Action Due Before"
          },
          {
            "name": "keyword",
            "in": "query",
            "description": "Text to look for in the post title or body. Not case-sensitive.",
            "required": false,
            "type": "string",
            "x-ms-summary": "Keyword"
          },
          {
            "name": "top",
            "in": "query",
            "description": "Maximum number of posts to return, from 1 to 50.",
            "required": false,
            "type": "integer",
            "default": 20,
            "x-ms-summary": "Max Posts"
          }
        ],
        "responses": {
          "200": {
            "description": "The matching posts.",
            "schema": {
              "$ref": "#/definitions/MessageList"
            }
          },
          "400": {
            "description": "A filter value was invalid."
          },
          "401": {
            "description": "Unauthorized - Invalid credentials or token."
          },
          "403": {
            "description": "Forbidden - The signed-in user lacks an admin role that can read Message Center, or admin consent is missing."
          },
          "429": {
            "description": "Too many requests - Microsoft Graph throttled the call."
          }
        },
        "security": [
          {
            "oauth2": [
              "https://graph.microsoft.com/.default"
            ]
          }
        ]
      }
    },
    "/admin/serviceAnnouncement/messages/{messageId}": {
      "get": {
        "summary": "Get Message Center Post",
        "description": "Get one Message Center post: full text, links, tags, affected services, dates, action-required deadline, and your read, archived and favorite status.",
        "operationId": "GetMessage",
        "parameters": [
          {
            "name": "messageId",
            "in": "path",
            "description": "The post to get. Pick it from the list, or enter its ID, for example MC123456.",
            "required": true,
            "type": "string",
            "x-ms-url-encoding": "single",
            "x-ms-summary": "Post",
            "x-ms-dynamic-values": {
              "operationId": "GetMessageDropdown",
              "value-path": "id",
              "value-title": "name"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The post.",
            "schema": {
              "$ref": "#/definitions/MessageDetail"
            }
          },
          "400": {
            "description": "The post ID was invalid."
          },
          "401": {
            "description": "Unauthorized - Invalid credentials or token."
          },
          "403": {
            "description": "Forbidden - The signed-in user lacks an admin role that can read Message Center, or admin consent is missing."
          },
          "404": {
            "description": "Post not found."
          }
        },
        "security": [
          {
            "oauth2": [
              "https://graph.microsoft.com/.default"
            ]
          }
        ]
      }
    },
    "/admin/serviceAnnouncement/messages/{messageId}/attachments": {
      "get": {
        "summary": "List Post Attachments",
        "description": "List the attachments of a Message Center post.",
        "operationId": "ListMessageAttachments",
        "parameters": [
          {
            "name": "messageId",
            "in": "path",
            "description": "The post whose attachments to list. Pick it from the list, or enter its ID, for example MC123456.",
            "required": true,
            "type": "string",
            "x-ms-url-encoding": "single",
            "x-ms-summary": "Post",
            "x-ms-dynamic-values": {
              "operationId": "GetMessageDropdown",
              "value-path": "id",
              "value-title": "name"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The post's attachments.",
            "schema": {
              "$ref": "#/definitions/AttachmentList"
            }
          },
          "401": {
            "description": "Unauthorized - Invalid credentials or token."
          },
          "403": {
            "description": "Forbidden - The signed-in user lacks an admin role that can read Message Center, or admin consent is missing."
          },
          "404": {
            "description": "Post not found."
          }
        },
        "security": [
          {
            "oauth2": [
              "https://graph.microsoft.com/.default"
            ]
          }
        ]
      }
    },
