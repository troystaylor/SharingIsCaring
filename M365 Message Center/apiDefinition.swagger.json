    }
  ],
  "definitions": {
    "MessageSummary": {
      "type": "object",
      "description": "A Message Center post with a short summary.",
      "properties": {
        "id": {
          "type": "string",
          "description": "The post ID, for example MC123456.",
          "x-ms-summary": "Post ID"
        },
        "title": {
          "type": "string",
          "description": "The post title.",
          "x-ms-summary": "Title"
        },
        "category": {
          "type": "string",
          "description": "PlanForChange, PreventOrFixIssue or StayInformed.",
          "x-ms-summary": "Category"
        },
        "severity": {
          "type": "string",
          "description": "Normal, High or Critical.",
          "x-ms-summary": "Severity"
        },
        "services": {
          "type": "array",
          "description": "The services the post affects.",
          "x-ms-summary": "Services",
          "items": {
            "type": "string"
          }
        },
        "tags": {
          "type": "array",
          "description": "Tags such as New feature, Updated message or Retirement.",
          "x-ms-summary": "Tags",
          "items": {
            "type": "string"
          }
        },
        "isMajorChange": {
          "type": "boolean",
          "description": "Whether the post describes a major change.",
          "x-ms-summary": "Major Change"
        },
        "startDateTime": {
          "type": "string",
          "description": "When the post starts.",
          "x-ms-summary": "Start"
        },
        "endDateTime": {
          "type": "string",
          "description": "When the post ends.",
          "x-ms-summary": "End"
        },
        "lastModifiedDateTime": {
          "type": "string",
          "description": "When the post was last updated.",
          "x-ms-summary": "Last Modified"
        },
        "actionRequiredByDateTime": {
          "type": "string",
          "description": "The deadline for any action you need to take. Empty when no action is required.",
          "x-ms-summary": "Action Required By"
        },
        "hasAttachments": {
          "type": "boolean",
          "description": "Whether the post has attachments.",
          "x-ms-summary": "Has Attachments"
        },
        "isRead": {
          "type": "boolean",
          "description": "Whether you marked the post as read.",
          "x-ms-summary": "Is Read"
        },
        "isArchived": {
          "type": "boolean",
          "description": "Whether you archived the post.",
          "x-ms-summary": "Is Archived"
        },
        "isFavorited": {
          "type": "boolean",
          "description": "Whether you marked the post as a favorite.",
          "x-ms-summary": "Is Favorited"
        },
        "adminCenterUrl": {
          "type": "string",
          "description": "Link to the post in the Microsoft 365 admin center.",
          "x-ms-summary": "Admin Center Link"
        },
        "summary": {
          "type": "string",
          "description": "The first part of the post text.",
          "x-ms-summary": "Summary"
        }
      }
    },
    "MessageList": {
      "type": "object",
      "description": "Message Center posts that match the filters.",
      "properties": {
        "count": {
          "type": "integer",
          "description": "How many posts are in the messages list.",
          "x-ms-summary": "Count"
        },
        "totalMatches": {
          "type": "integer",
          "description": "How many posts matched before the Max Posts limit was applied.",
          "x-ms-summary": "Total Matches"
        },
        "scannedCount": {
          "type": "integer",
          "description": "How many posts were examined.",
          "x-ms-summary": "Scanned Count"
        },
        "truncated": {
          "type": "boolean",
          "description": "True when the scan stopped at its limit and more posts exist. Narrow the filters.",
          "x-ms-summary": "Truncated"
        },
        "messages": {
          "type": "array",
          "description": "The posts, most recently changed first.",
          "x-ms-summary": "Posts",
          "items": {
            "$ref": "#/definitions/MessageSummary"
          }
        }
      }
    },
    "MessageTriggerList": {
      "type": "object",
      "description": "Posts that changed since the previous check.",
      "properties": {
        "value": {
          "type": "array",
          "description": "The posts, newest first.",
          "x-ms-summary": "Posts",
          "items": {
            "$ref": "#/definitions/MessageSummary"
          }
        }
      }
    },
    "MessageDetail": {
      "type": "object",
      "description": "A Message Center post with its full text.",
      "properties": {
        "id": {
          "type": "string",
          "description": "The post ID, for example MC123456.",
          "x-ms-summary": "Post ID"
        },
        "title": {
          "type": "string",
          "description": "The post title.",
          "x-ms-summary": "Title"
        },
        "category": {
          "type": "string",
          "description": "PlanForChange, PreventOrFixIssue or StayInformed.",
          "x-ms-summary": "Category"
        },
        "severity": {
          "type": "string",
          "description": "Normal, High or Critical.",
          "x-ms-summary": "Severity"
        },
        "services": {
          "type": "array",
          "description": "The services the post affects.",
          "x-ms-summary": "Services",
          "items": {
            "type": "string"
          }
        },
        "tags": {
          "type": "array",
          "description": "Tags such as New feature, Updated message or Retirement.",
          "x-ms-summary": "Tags",
          "items": {
            "type": "string"
          }
        },
        "isMajorChange": {
          "type": "boolean",
          "description": "Whether the post describes a major change.",
          "x-ms-summary": "Major Change"
        },
        "startDateTime": {
