    "/trigger/messages": {
      "get": {
        "summary": "When a Message Center post is published or updated",
        "description": "Fires when a Message Center post is published or updated. Power Automate checks for changes on a schedule, so a flow starts within a few minutes of a post changing. When you turn the flow on, the newest post sets the starting point and does not start the flow.",
        "operationId": "OnMessageCenterPost",
        "x-ms-trigger": "batch",
        "x-ms-trigger-metadata": {
          "mode": "polling",
          "kind": "query"
        },
        "x-ms-trigger-hint": "To see it work, wait for Microsoft to publish or update a Message Center post that matches your filters.",
        "x-ms-visibility": "important",
        "parameters": [
          {
            "name": "service",
            "in": "query",
            "description": "Only posts that affect this service, for example Microsoft Teams, Exchange Online or SharePoint Online.",
            "required": false,
            "type": "string",
            "x-ms-summary": "Service"
          },
          {
            "name": "category",
            "in": "query",
            "description": "Plan for change, Prevent or fix issue, or Stay informed.",
            "required": false,
            "type": "string",
            "enum": [
              "planForChange",
              "preventOrFixIssue",
              "stayInformed"
            ],
            "x-ms-summary": "Category"
          },
          {
            "name": "severity",
            "in": "query",
            "description": "The severity of the post.",
            "required": false,
            "type": "string",
            "enum": [
              "normal",
              "high",
              "critical"
            ],
            "x-ms-summary": "Severity"
          },
          {
            "name": "majorChangeOnly",
            "in": "query",
            "description": "Only posts marked as a major change.",
            "required": false,
            "type": "boolean",
            "default": false,
            "x-ms-summary": "Major Changes Only"
          },
          {
            "name": "newOnly",
            "in": "query",
            "description": "Skip posts Microsoft revised after publishing. These carry the Updated message tag or an (Updated) title prefix. Message Center has no creation date, so this relies on that tag.",
            "required": false,
            "type": "boolean",
            "default": false,
            "x-ms-summary": "New Posts Only"
          },
          {
            "name": "keyword",
            "in": "query",
            "description": "Only posts whose title or body contains this text. Not case-sensitive.",
            "required": false,
            "type": "string",
            "x-ms-summary": "Keyword"
          },
          {
            "name": "since",
            "in": "query",
            "description": "Set by the flow. The last modified time of the newest post already seen.",
            "required": false,
            "type": "string",
            "default": "1970-01-01T00:00:00Z",
            "x-ms-visibility": "internal",
            "x-ms-summary": "Since",
            "x-ms-trigger-value": {
              "value-collection": "value",
              "value-path": "lastModifiedDateTime"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Posts published or updated since the previous check, newest first.",
            "schema": {
              "$ref": "#/definitions/MessageTriggerList"
            }
          },
          "202": {
            "description": "No new or updated posts."
          },
          "400": {
            "description": "A filter value was invalid."
          },
          "401": {
            "description": "Unauthorized - Invalid credentials or token."
          },
          "403": {
            "description": "Forbidden - The signed-in user lacks an admin role that can read Message Center, or admin consent is missing."
          }
        },
        "security": [
          {
            "oauth2": [
              "https://graph.microsoft.com/.default"
            ]
          }
        ]
      }
    },
    "/metadata/messages": {
      "get": {
        "summary": "Get Post List",
        "description": "Internal operation that backs the post dropdown. Returns the IDs and titles of posts from the last 90 days.",
        "operationId": "GetMessageDropdown",
        "x-ms-visibility": "internal",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Post list for the dropdown.",
            "schema": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "description": "Post ID"
                  },
                  "name": {
                    "type": "string",
                    "description": "Post ID and title"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - Invalid credentials or token."
          }
        },
        "security": [
          {
            "oauth2": [
              "https://graph.microsoft.com/.default"
            ]
          }
        ]
      }
    },
    "/": {
      "post": {
        "summary": "Invoke M365 Message Center MCP",
        "description": "Model Context Protocol endpoint for Copilot Studio. Handles JSON-RPC 2.0 requests for the list posts, get post, list attachments and set post status tools.",
        "operationId": "InvokeMCP",
        "parameters": [],
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "responses": {
          "200": {
            "description": "MCP request processed successfully.",
            "schema": {
              "type": "object"
            }
          },
          "400": {
            "description": "Invalid MCP request format."
          },
          "500": {
            "description": "MCP processing error."
          }
        },
        "security": [
          {
            "oauth2": [
              "https://graph.microsoft.com/.default"
            ]
          }
        ],
        "x-ms-agentic-protocol": "mcp-streamable-1.0"
      }
    }
  },
  "securityDefinitions": {
    "oauth2": {
      "type": "oauth2",
      "flow": "accessCode",
      "authorizationUrl": "https://login.microsoftonline.com/common/oauth2/v2.0/authorize",
      "tokenUrl": "https://login.microsoftonline.com/common/oauth2/v2.0/token",
      "scopes": {
        "https://graph.microsoft.com/.default": "Read Message Center posts and manage your read status"
      }
    }
  },
