{
  "properties": {
    "connectionParameters": {
      "token": {
        "type": "oauthSetting",
        "oAuthSettings": {
          "identityProvider": "aad",
          "clientId": "[YOUR_CLIENT_ID]",
          "scopes": [
            "https://graph.microsoft.com/.default offline_access"
          ],
          "redirectMode": "Global",
          "redirectUrl": "[YOUR_REDIRECT_URL]",
          "properties": {
            "IsFirstParty": "False",
            "AzureActiveDirectoryResourceId": "https://graph.microsoft.com"
          },
          "customParameters": {
            "loginUri": {
              "value": "https://login.microsoftonline.com"
            },
            "tenantId": {
              "value": "common"
            },
            "resourceUri": {
              "value": "https://graph.microsoft.com"
            }
          }
        }
      }
    },
    "iconBrandColor": "#0078D7",
    "capabilities": [],
    "publisher": "Troy Taylor",
    "stackOwner": "Microsoft",
    "scriptOperations": [
      "ListMessages",
      "GetMessage",
      "ListMessageAttachments",
      "MarkMessagesRead",
      "MarkMessagesUnread",
      "ArchiveMessages",
      "UnarchiveMessages",
      "FavoriteMessages",
      "UnfavoriteMessages",
      "GetMessageDropdown",
      "OnMessageCenterPost",
      "InvokeMCP"
    ]
  }
}
