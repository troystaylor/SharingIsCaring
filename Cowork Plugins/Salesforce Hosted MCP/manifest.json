{
  "$schema": "https://developer.microsoft.com/json-schemas/teams/vDevPreview/MicrosoftTeams.schema.json",
  "manifestVersion": "devPreview",
  "version": "1.0.0",
  "id": "b6114000-87b3-4341-8b33-ea7c665721cc",
  "packageName": "com.troytaylor.salesforce-hosted-mcp",
  "developer": {
    "name": "Troy Taylor",
    "websiteUrl": "https://troystaylor.com",
    "privacyUrl": "https://troystaylor.com",
    "termsOfUseUrl": "https://troystaylor.com"
  },
  "name": {
    "short": "Salesforce (Hosted MCP)",
    "full": "Salesforce for Copilot Cowork (Hosted MCP)"
  },
  "description": {
    "short": "Salesforce CRM workflows in Cowork over Salesforce's own hosted MCP server.",
    "full": "Brings Salesforce CRM workflows into Copilot Cowork using Salesforce Hosted MCP Servers — no self-hosted MCP server, container app, or Azure infrastructure required. Layers CRM domain knowledge on top of the Salesforce-operated sObject tools: account briefings, opportunity health and risk analysis, pipeline review, next-best-action guidance, lead follow-up, case triage, contact discovery, activity logging, and confirmation-gated write actions. Every action runs as the signed-in Salesforce user and respects that user's profile, sharing rules, and field-level security."
  },
  "icons": {
    "color": "color.png",
    "outline": "outline.png"
  },
  "accentColor": "#0176D3",
  "agentSkills": [
    { "folder": "./skills/account-briefing" },
    { "folder": "./skills/opportunity-health-summary" },
    { "folder": "./skills/pipeline-review" },
    { "folder": "./skills/open-risks-and-blockers" },
    { "folder": "./skills/next-best-action" },
    { "folder": "./skills/find-contacts" },
    { "folder": "./skills/review-tasks" },
    { "folder": "./skills/lead-followup" },
    { "folder": "./skills/case-triage" },
    { "folder": "./skills/explore-salesforce-data" },
    { "folder": "./skills/create-account" },
    { "folder": "./skills/update-account" },
    { "folder": "./skills/create-opportunity" },
    { "folder": "./skills/update-opportunity" },
    { "folder": "./skills/add-contact" },
    { "folder": "./skills/update-contact" },
    { "folder": "./skills/log-call-notes" },
    { "folder": "./skills/delete-salesforce-record" },
    { "folder": "./skills/improve-skills" }
  ],
  "agentConnectors": [
    {
      "id": "salesforce-hosted-mcp",
      "displayName": "Salesforce",
      "description": "Query, create, update, and delete Salesforce records through the Salesforce-hosted platform/sobject-all MCP server. Runs as the signed-in Salesforce user.",
      "toolSource": {
        "remoteMcpServer": {
          "mcpServerUrl": "https://api.salesforce.com/platform/mcp/v1/platform/sobject-all",
          "authorization": {
            "type": "OAuthPluginVault",
            "referenceId": "{{OAUTH_REFERENCE_ID}}"
          }
        }
      }
    }
  ]
}
