{
  "properties": {
    "connectionParameters": {
      "token": {
        "type": "oauthSetting",
        "oAuthSettings": {
          "identityProvider": "SalesforceV2",
          "clientId": "[YOUR_CLIENT_ID]",
          "clientSecret": "[YOUR_CLIENT_SECRET]",
          "scopes": [
            "api refresh_token openid"
          ],
          "redirectMode": "Global",
          "redirectUrl": "[YOUR_REDIRECT_URL]",
          "properties": {
            "IsFirstParty": "False",
            "IsOnbehalfofLoginSupported": false
          },
          "customParameters": {
            "LoginUri": {
              "value": "https://[YOUR_MY_DOMAIN].my.salesforce.com"
            }
          }
        },
        "uiDefinition": {
          "displayName": "Salesforce sign-in",
          "description": "Sign in to Salesforce. Requests run as you, with your own permissions."
        }
      }
    },
    "iconBrandColor": "#00A1E0",
    "scriptOperations": [],
    "capabilities": [],
    "policyTemplateInstances": [],
    "publisher": "Troy Taylor",
    "stackOwner": "Troy Taylor"
  }
}
