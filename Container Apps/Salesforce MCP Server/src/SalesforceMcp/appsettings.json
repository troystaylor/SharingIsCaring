{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Auth": {
    "Enabled": true,
    "ResourceUri": null,
    "ValidationCacheSeconds": 60
  },

  "RateLimit": {
    "PermitsPerMinute": 120
  },

  "Salesforce": {
    "InstanceUrl": "",
    "ApiVersion": "v66.0",
    "EnableWriteTools": false,
    "EnableToolingTools": true,
    "SchemaCacheSeconds": 300,
    "SchemaCacheMaxEntries": 200,
    "MaxRecords": 200,
    "MaxResponseChars": 100000
  }
}
