{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Auth": {
    "Enabled": true,
    "ValidationCacheSeconds": 60
  },

  "RateLimit": {
    "PermitsPerMinute": 120
  },

  "Limits": {
    "MaxItems": 50,
    "MaxResponseChars": 100000,
    "MaxTextChars": 30000
  },

  "Atlassian": {
    "SiteUrl": ""
  },

  "Jira": {
    "Enabled": true,
    "EnableWriteTools": false
  },

  "Confluence": {
    "Enabled": true,
    "EnableWriteTools": false
  },

  "Bitbucket": {
    "Enabled": true,
    "EnableWriteTools": false,
    "Workspace": null
  }
}
