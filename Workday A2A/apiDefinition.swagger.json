{
  "swagger": "2.0",
  "info": {
    "title": "Workday Self-Service Agent",
    "description": "Connects a Copilot Studio agent to the Workday Self-Service Agent over the Agent2Agent (A2A) protocol, authenticated with OAuth authorization code and PKCE.",
    "version": "1.0.0",
    "contact": {
      "name": "Troy Taylor",
      "email": "troy@troystaylor.com",
      "url": "https://github.com/troystaylor"
    }
  },
  "host": "your-region.agent.workday.com",
  "basePath": "/",
  "schemes": [
    "https"
  ],
  "consumes": [],
  "produces": [],
  "paths": {
    "/v1/a2a/YOUR_TENANT_ALIAS/YOUR_AGENT_WID": {
      "post": {
        "operationId": "InvokeA2A",
        "summary": "Workday Self-Service Agent",
        "description": "Answers employee and manager questions and completes self-service tasks in Workday, such as time off, pay, benefits, personal information, staffing, and HR operations, on behalf of the signed-in user.",
        "x-ms-agentic-protocol": "a2a-1.0",
        "x-ms-a2a-card-endpoint": "https://your-region.agent.workday.com/v1/a2a/YOUR_TENANT_ALIAS/YOUR_AGENT_WID/.well-known/agent-card.json",
        "x-ms-a2a-card-json": "null",
        "tags": [
          "A2A"
        ],
        "responses": {
          "default": {
            "description": "default",
            "schema": {}
          }
        }
      }
    }
  },
  "definitions": {},
  "parameters": {},
  "responses": {},
  "securityDefinitions": {
    "oauth2_auth": {
      "type": "oauth2",
      "flow": "accessCode",
      "authorizationUrl": "https://your-region.agent.workday.com/auth/authorize/YOUR_TENANT_ALIAS",
      "tokenUrl": "https://your-region.agent.workday.com/auth/oauth2/YOUR_TENANT_ALIAS/token",
      "scopes": {}
    }
  },
  "security": [
    {
      "oauth2_auth": []
    }
  ],
  "tags": [],
