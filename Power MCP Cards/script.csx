      if (!series.length) return null;
      body = kind === 'hbar' ? bars(el, ctx, false) : kind === 'bar' ? bars(el, ctx, true) : lines(el, ctx, kind === 'area');
      summary = series.map(function (s) {
        return (series.length > 1 ? s.name + ': ' : '') + s.points.map(function (p) { return p.label + ' ' + p.value; }).join(', ');
      }).join('. ');
      if (series.length > 1) extra = legend(series.map(function (s, i) { return { color: colorOf(s.color, i), label: s.name }; }));
    }

    var fig = h('figure', { class: 'fig', role: 'img', 'aria-label': (title ? title + '. ' : '') + summary },
      title ? h('figcaption', { class: 'fig-t', text: title }) : null, body, extra);
    return fig;
