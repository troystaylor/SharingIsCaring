    var title = text(ctx.ev(el.title));
    var key = JSON.stringify([title, columns.length, rows.length, rows[0]]);
    var state = TABLES[el.id];
    if (!state || state.key !== key) state = TABLES[el.id] = { key: key, sort: null, dir: 1, filter: '', selected: {}, inlineOpen: false };

    var search = h('input', { class: 'search', type: 'search', placeholder: 'Search', 'aria-label': 'Search rows', value: state.filter,
