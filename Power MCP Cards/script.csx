    var series = seriesOf(el, ctx);
    var cats = series[0].points.map(function (p) { return p.label; });
    var peak = Number(ctx.ev(el.max)), floor = el.min === undefined ? 0 : Number(ctx.ev(el.min));
    if (!peak) { peak = 0; series.forEach(function (s) { s.points.forEach(function (p) { peak = Math.max(peak, p.value); }); }); }
    var sc = scale(peak);
    var height = Number(el.height) || 200, lm = 40, bm = 26, tm = 14, rm = 10, plot = height - bm - tm;
    var svg = node('svg', { viewBox: '0 0 ' + W + ' ' + height, 'class': 'chart', 'aria-hidden': 'true' });
    sc.ticks.forEach(function (t) {
      var y = tm + plot - plot * (t - floor) / (sc.top - floor);
      node('line', { x1: String(lm), x2: String(W - rm), y1: String(y), y2: String(y), 'class': 'ch-grid' }, svg);
      label(svg, lm - 6, y + 3, fmt(t), { 'text-anchor': 'end' });
    });
    var span = cats.length > 1 ? (W - lm - rm) / (cats.length - 1) : 0;
    var xAt = function (i) { return cats.length > 1 ? lm + i * span : lm + (W - lm - rm) / 2; };
    var yAt = function (v) { return tm + plot - plot * (v - floor) / (sc.top - floor); };
    series.forEach(function (s, si) {
      var color = colorOf(s.color, si);
      var d = s.points.map(function (p, i) { return (i ? 'L' : 'M') + xAt(i).toFixed(1) + ' ' + yAt(p.value).toFixed(1); }).join(' ');
      if (area && s.points.length > 1) node('path', { d: d + ' L' + xAt(s.points.length - 1).toFixed(1) + ' ' + (tm + plot) + ' L' + xAt(0).toFixed(1) + ' ' + (tm + plot) + ' Z', fill: color, opacity: '0.16' }, svg);
      node('path', { d: d, fill: 'none', stroke: color, 'stroke-width': '2', 'stroke-linejoin': 'round', 'stroke-linecap': 'round' }, svg);
      s.points.forEach(function (p, i) { node('circle', { cx: String(xAt(i)), cy: String(yAt(p.value)), r: '3', fill: color }, svg); });
    });
    var every = Math.max(1, Math.ceil(cats.length / 7));
    cats.forEach(function (c, i) { if (i % every === 0) label(svg, xAt(i), height - 8, short(c, 8), { 'text-anchor': 'middle' }); });
    return svg;
  }

  function sparkline(el, ctx) {
    var pts = pointsOf(ctx, el.points || []);
    var height = Number(el.height) || 32;
    var svg = node('svg', { viewBox: '0 0 ' + W + ' ' + height, 'class': 'chart spark', 'aria-hidden': 'true', preserveAspectRatio: 'none' });
    if (pts.length < 2) return svg;
    var lo = Math.min.apply(null, pts.map(function (p) { return p.value; })), hi = Math.max.apply(null, pts.map(function (p) { return p.value; }));
    var d = pts.map(function (p, i) {
      var x = 4 + i * (W - 8) / (pts.length - 1), y = height - 4 - (hi === lo ? 0.5 : (p.value - lo) / (hi - lo)) * (height - 8);
      return (i ? 'L' : 'M') + x.toFixed(1) + ' ' + y.toFixed(1);
    }).join(' ');
    node('path', { d: d, fill: 'none', stroke: colorOf(el.color, 0), 'stroke-width': '2', 'stroke-linejoin': 'round', 'stroke-linecap': 'round', 'vector-effect': 'non-scaling-stroke' }, svg);
    return svg;
  }

  function donut(el, ctx, hole) {
    var pts = pointsOf(ctx, el.points || []).filter(function (p) { return p.value > 0; });
    var total = pts.reduce(function (t, p) { return t + p.value; }, 0);
    var size = 160, c = size / 2, r = hole ? 62 : 40, sw = hole ? 26 : 80;
    var svg = node('svg', { viewBox: '0 0 ' + size + ' ' + size, 'class': 'chart donut', 'aria-hidden': 'true' });
    if (!total) return { svg: svg, items: [] };
    var at = 0, items = [];
    pts.forEach(function (p, i) {
