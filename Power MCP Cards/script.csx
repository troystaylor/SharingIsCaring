    if (format === 'check') {
      var on = raw === true || text(raw).toLowerCase() === 'true';
      return on ? h('span', { class: 'ok', title: 'Yes' }, icon('check'), h('span', { class: 'sr', text: 'Yes' })) : h('span', { class: 'sr', text: 'No' });
