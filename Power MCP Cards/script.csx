    private const string ChartsJs = @"/* Card engine module: charts drawn as SVG, with no libraries. Kinds: bar, hbar, line, area, donut, pie, gauge, sparkline.
   Every chart has a text summary for screen readers. Single quotes only. */
(function (E) {
  var NS = 'http://www.w3.org/2000/svg';
  var W = 480;
  var TONES = { brand: 'var(--brandfg)', good: 'var(--grn-fg)', warning: 'var(--org-fg)', attention: 'var(--red-fg)', subtle: 'var(--fg3)' };

  function node(tag, attrs, parent) {
    var e = document.createElementNS(NS, tag);
    for (var k in attrs) e.setAttribute(k, attrs[k]);
    if (parent) parent.appendChild(e);
    return e;
  }

  function colorOf(value, index) {
    var v = text(value);
    if (/^c[1-8]$/.test(v)) return 'var(--' + v + ')';
    if (TONES[v]) return TONES[v];
    if (/^#[0-9a-fA-F]{3,8}$/.test(v)) return v;
    return 'var(--c' + (index % 8 + 1) + ')';
  }

  function pointsOf(ctx, source) {
    return E.itemsOf(ctx, source).map(function (p) {
      var o = p && typeof p === 'object' ? p : { value: p };
      return { label: text(o.label), value: Number(o.value) || 0, color: o.color };
    });
  }

  // A tidy upper bound for an axis, and the tick values up to it.
  function scale(max) {
    if (max <= 0) return { top: 1, ticks: [0, 1] };
    var exp = Math.pow(10, Math.floor(Math.log(max) / Math.LN10));
    var f = max / exp;
    var step = (f <= 1 ? 1 : f <= 2 ? 2 : f <= 5 ? 5 : 10) * exp / (f <= 1 ? 5 : f <= 2 ? 4 : f <= 5 ? 5 : 5);
    var top = Math.ceil(max / step) * step, ticks = [];
    for (var v = 0; v <= top + step / 1000; v += step) ticks.push(Math.round(v * 1e6) / 1e6);
    return { top: top, ticks: ticks };
  }

  function short(s, n) { s = text(s); return s.length > n ? s.substring(0, Math.max(1, n - 1)) + '\u2026' : s; }
  function fmt(n, unit) { return text(Expr.functions.number(n)) + (unit ? text(unit) : ''); }

  function label(parent, x, y, s, attrs) {
    var t = node('text', { x: String(x), y: String(y), 'class': 'ch-t' }, parent);
    for (var k in attrs) t.setAttribute(k, attrs[k]);
    t.textContent = s;
    return t;
  }

  function legend(items) {
    return h('ul', { class: 'legend' }, items.map(function (i) {
      return h('li', null, h('span', { class: 'sw', style: 'background:' + i.color }), h('span', { text: i.label }), i.value === undefined ? null : h('span', { class: 'cap', text: i.value }));
    }));
  }

  function arc(cx, cy, r, from, to) {
    var a0 = from - Math.PI / 2, a1 = to - Math.PI / 2;
    var x0 = cx + r * Math.cos(a0), y0 = cy + r * Math.sin(a0), x1 = cx + r * Math.cos(a1), y1 = cy + r * Math.sin(a1);
    return 'M' + x0.toFixed(2) + ' ' + y0.toFixed(2) + ' A' + r + ' ' + r + ' 0 ' + (to - from > Math.PI ? 1 : 0) + ' 1 ' + x1.toFixed(2) + ' ' + y1.toFixed(2);
  }

  function bars(el, ctx, vertical) {
    var series = seriesOf(el, ctx);
    var cats = series[0].points.map(function (p) { return p.label; });
    var peak = Number(ctx.ev(el.max));
    if (!peak) { peak = 0; series.forEach(function (s) { s.points.forEach(function (p) { peak = Math.max(peak, p.value); }); }); }
    var sc = scale(peak);
    var unit = el.unit;

    if (!vertical) {
      var rowH = 30, left = 110, right = 60, height = cats.length * rowH + 8;
      var svg = node('svg', { viewBox: '0 0 ' + W + ' ' + height, 'class': 'chart', 'aria-hidden': 'true' });
      series[0].points.forEach(function (p, i) {
        var y = 4 + i * rowH, w = Math.max(0, (W - left - right) * p.value / sc.top);
        label(svg, left - 8, y + rowH / 2 + 3, short(p.label, 14), { 'text-anchor': 'end' });
        node('rect', { x: String(left), y: String(y + 4), width: String(w), height: String(rowH - 10), rx: '3', fill: colorOf(p.color || series[0].color, el.colorByPoint && !p.color ? i : 0) }, svg);
        label(svg, left + w + 6, y + rowH / 2 + 3, fmt(p.value, unit), {});
      });
      return svg;
    }

    var height2 = Number(el.height) || 200, lm = 40, bm = 26, tm = 14, rm = 6;
    var plot = height2 - bm - tm;
    var s2 = node('svg', { viewBox: '0 0 ' + W + ' ' + height2, 'class': 'chart', 'aria-hidden': 'true' });
    sc.ticks.forEach(function (t) {
      var y = tm + plot - plot * t / sc.top;
      node('line', { x1: String(lm), x2: String(W - rm), y1: String(y), y2: String(y), 'class': 'ch-grid' }, s2);
      label(s2, lm - 6, y + 3, fmt(t), { 'text-anchor': 'end' });
    });
    var band = (W - lm - rm) / cats.length, gap = Math.min(10, band * 0.25), inner = (band - gap) / series.length;
    cats.forEach(function (c, ci) {
      var x0 = lm + ci * band + gap / 2;
      series.forEach(function (s, si) {
        var p = s.points[ci] || { value: 0 };
        var hgt = Math.max(0, plot * p.value / sc.top);
        var color = colorOf(p.color || s.color, series.length > 1 ? si : (el.colorByPoint && !p.color ? ci : 0));
        node('rect', { x: String(x0 + si * inner), y: String(tm + plot - hgt), width: String(Math.max(1, inner - 2)), height: String(hgt), rx: '3', fill: color }, s2);
        if (series.length === 1 && cats.length <= 8) label(s2, x0 + inner / 2, tm + plot - hgt - 4, fmt(p.value, unit), { 'text-anchor': 'middle' });
      });
