    like: 'heart', 'thumb-like': 'thumb-up', 'leaf-one': 'leaf', 'leaf-two': 'leaf', 'circle-small': 'circle', favorite: 'star', pencil: 'edit', remove: 'delete', next: 'chevron-right', back: 'chevron-left', up: 'arrow-up', down: 'arrow-down', ok: 'success', bad: 'error' };

  function sizeOf(size) {
