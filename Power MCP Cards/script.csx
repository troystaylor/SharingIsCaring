      body = d.svg;
      extra = legend(d.items);
      summary = d.items.map(function (i) { return i.label + ' ' + i.value; }).join(', ');
    } else if (kind === 'gauge') {
      body = gauge(el, ctx);
      summary = 'Value ' + text(ctx.ev(el.value)) + (el.unit ? text(el.unit) : '');
    } else if (kind === 'sparkline') {
      body = sparkline(el, ctx);
      summary = pointsOf(ctx, el.points || []).map(function (p) { return p.value; }).join(', ');
    } else {
