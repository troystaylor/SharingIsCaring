    var share = max === min ? 0 : (value - min) / (max - min);
    var svg = node('svg', { viewBox: '0 0 200 120', 'class': 'chart gauge', 'aria-hidden': 'true' });
    var track = node('path', { d: arc(100, 100, 80, -Math.PI / 2, Math.PI / 2), fill: 'none', 'class': 'ch-track', 'stroke-width': '16', 'stroke-linecap': 'round' }, svg);
    void track;
    if (share > 0) node('path', { d: arc(100, 100, 80, -Math.PI / 2, -Math.PI / 2 + Math.PI * share), fill: 'none', stroke: colorOf(el.color || (share >= 0.75 ? 'good' : share >= 0.4 ? 'brand' : 'warning'), 0), 'stroke-width': '16', 'stroke-linecap': 'round' }, svg);
    label(svg, 100, 92, fmt(value, el.unit), { 'text-anchor': 'middle', 'class': 'ch-big' });
    label(svg, 20, 116, fmt(min), { 'text-anchor': 'middle' });
    label(svg, 180, 116, fmt(max), { 'text-anchor': 'middle' });
