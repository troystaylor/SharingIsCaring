      if (pts.length === 1) node('circle', { cx: String(c), cy: String(c), r: String(r), fill: 'none', stroke: color, 'stroke-width': String(sw) }, svg);
      else node('path', { d: arc(c, c, r, at * 2 * Math.PI, (at + share) * 2 * Math.PI), fill: 'none', stroke: color, 'stroke-width': String(sw) }, svg);
      at += share;
