  var URL = /^https?:\/\/\S+$/i;
  var PHONE = /^[+(]?[0-9][0-9\s().-]{3,}$/;
  var INPUT_TYPES = { email: 'email', number: 'number', date: 'date', time: 'time', url: 'url', tel: 'tel', datetime: 'datetime-local', text: 'text' };

  function optionsOf(f) {
    return (f.options || []).map(function (o) {
      if (o && typeof o === 'object') return { label: text(o.label !== undefined ? o.label : o.value), value: text(o.value !== undefined ? o.value : o.label) };
