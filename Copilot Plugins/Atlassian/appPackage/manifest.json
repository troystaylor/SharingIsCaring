{
  "$schema": "https://developer.microsoft.com/en-us/json-schemas/teams/v1.29/MicrosoftTeams.schema.json",
  "manifestVersion": "1.29",
  "version": "1.0.0",
  "id": "${{TEAMS_APP_ID}}",
  "developer": {
    "name": "Troy Taylor",
    "websiteUrl": "https://www.atlassian.com/platform/remote-mcp-server",
    "privacyUrl": "https://www.atlassian.com/legal/privacy-policy",
    "termsOfUseUrl": "https://www.atlassian.com/legal/cloud-terms-of-service"
  },
  "icons": {
    "color": "color.png",
    "outline": "outline.png"
  },
  "name": {
    "short": "Atlassian${{APP_NAME_SUFFIX}}",
    "full": "Atlassian (Jira, Confluence and more)"
  },
  "description": {
    "short": "Sourced answers from Jira, Confluence and Bitbucket.",
    "full": "Connects Microsoft 365 Copilot to the official Atlassian remote MCP server for Jira, Confluence and Bitbucket Cloud. Skills cover support triage, technical design help, specification verification, knowledge-base maintenance, weekly status reporting, code review, worklog signals, release notes, backlog hygiene, issue briefs, a personal work queue and meeting action items, built on shared rules for evidence, citations, query building and safe writes. Reads run as you under your Atlassian permissions; writes are draft-only and need confirmation. Every tool call is recorded in your organization's Atlassian audit log."
  },
  "accentColor": "#0052CC",
  "permissions": [
    "identity",
    "messageTeamMembers"
  ],
  "validDomains": [
    "mcp.atlassian.com"
  ],
  "agentConnectors": [
    {
      "id": "atlassian",
      "displayName": "Atlassian",
      "description": "Jira, Confluence, Compass, Bitbucket, Loom and Teamwork Graph through the official Atlassian remote MCP server.",
      "toolSource": {
        "remoteMcpServer": {
          "mcpServerUrl": "https://mcp.atlassian.com/v2/mcp",
          "authorization": {
            "type": "OAuthPluginVault",
            "referenceId": "${{ATLASSIAN_OAUTH_REFERENCE_ID}}"
          }
        }
      }
    }
  ],
  "agentSkills": [
    {
      "folder": "skills/atlassian-access"
    },
    {
      "folder": "skills/jql-cql-builder"
    },
    {
      "folder": "skills/evidence-and-uncertainty"
    },
    {
      "folder": "skills/write-safety"
    },
    {
      "folder": "skills/support-triage"
    },
    {
      "folder": "skills/technical-design-draft"
    },
    {
      "folder": "skills/spec-verify"
    },
    {
      "folder": "skills/knowledge-maintenance"
    },
    {
      "folder": "skills/status-reporting"
    },
    {
      "folder": "skills/code-review"
    },
    {
      "folder": "skills/worklog-signals"
    },
    {
      "folder": "skills/release-notes"
    },
    {
      "folder": "skills/backlog-hygiene"
    },
    {
      "folder": "skills/issue-brief"
    },
    {
      "folder": "skills/my-atlassian-queue"
    },
    {
      "folder": "skills/meeting-actions-to-jira"
    }
  ]
}
