          },
          "folderId": {
            "type": "string",
            "description": "Limit to lenses in this folder (app)."
          },
          "scope": {
            "type": "string",
            "enum": [
              "CreatedByMe",
              "SharedWithMe",
              "Mru"
            ],
            "description": "Filter by scope."
          },
          "sort": {
            "type": "string",
            "enum": [
              "Name",
              "Mru",
              "LastModified",
              "LastModifiedBy"
            ],
            "description": "Sort order."
          },
          "pageSize": {
            "type": "integer",
            "description": "Results per page, 1 to 200. Default 25."
          },
          "page": {
            "type": "string",
            "description": "Pagination token for the next page."
          }
        }
      },
      "annotations": {
        "title": "List lenses",
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "get_lens",
      "description": "Gets full lens metadata including the query definition and dataset reference.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "lensIdOrApiName": {
            "type": "string",
            "description": "The Id or API name of the lens."
          }
        },
        "required": [
          "lensIdOrApiName"
        ]
      },
      "annotations": {
        "title": "Get lens",
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    }
  ]
}
