    {
      "name": "create_compare_activity",
      "description": "Creates a compare that diffs two backups. Asynchronous: returns an activityId, then poll get_compare_activity.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "fromBackupId": {
            "type": "string",
            "description": "The Id of the older backup."
          },
          "toBackupId": {
            "type": "string",
            "description": "The Id of the newer backup."
          },
          "objects": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Objects to compare, or [\"all\"] for every object present in both backups."
          },
          "activityType": {
            "type": "string",
            "enum": [
              "COMPARE",
              "COMPARE_METADATA"
            ],
            "description": "COMPARE for data (default) or COMPARE_METADATA for metadata."
          }
        },
        "required": [
          "fromBackupId",
          "toBackupId",
          "objects"
        ]
      },
      "annotations": {
        "title": "Create compare activity",
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": false
      }
    },
    {
      "name": "update_selection_records",
      "description": "Updates which records are selected for restore on a COMPARE activity using batch filter and change expressions. Overwrites the prior selection; last matching batch wins. Not valid for RESTORE activities.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "activityId": {
            "type": "string",
            "description": "The Id of the COMPARE activity."
          },
          "objectName": {
            "type": "string",
            "description": "API name of the object."
          },
          "batches": {
            "type": "array",
            "items": {
              "type": "object"
            },
            "description": "Batches of {filterExp:[{fieldName,operator,value}], changeExp:[{fieldName:\"selectedForRestore\", value:\"true\"|\"false\"}]}."
          }
        },
        "required": [
          "activityId",
          "objectName",
          "batches"
        ]
      },
      "annotations": {
        "title": "Update selection records",
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    }
  ]
