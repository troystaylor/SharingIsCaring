{
  "tools": [
    {
      "name": "get_backups",
      "description": "Lists backups for the org with optional pagination and sort. Use first to discover backup Ids.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "pageNumber": {
            "type": "integer",
            "description": "Page number, starting at 1."
          },
          "pageSize": {
            "type": "integer",
            "description": "Number of items per page."
          },
          "sort": {
            "type": "string",
            "description": "Sort field, for example startTimestamp."
          },
          "sortDir": {
            "type": "string",
            "enum": [
              "ASC",
              "DESC"
            ],
            "description": "Sort direction."
          }
        }
      },
      "annotations": {
        "title": "Get backups",
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "get_backup_by_id",
      "description": "Returns the current state of one backup: status, counts and per-object detail. Use to poll after starting a backup.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "backupId": {
            "type": "string",
            "description": "The Id of the backup."
          }
        },
        "required": [
          "backupId"
        ]
      },
      "annotations": {
        "title": "Get backup by id",
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
