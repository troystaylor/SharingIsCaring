# Copy to env/.env.dev.user (gitignored). Never commit the real file.
# URL of your hosted Azure Maps MCP server, ending in /mcp, and its domain (used for validDomains).
AZURE_MAPS_MCP_SERVER_URL=https://<your-container-app>.<region>.azurecontainerapps.io/mcp
AZURE_MAPS_MCP_SERVER_DOMAIN=<your-container-app>.<region>.azurecontainerapps.io
# OAuth client registration ID from the Teams Developer Portal (Tools > OAuth client registration).
# The Entra client ID and secret live only in that registration, not in this repo.
AZURE_MAPS_OAUTH_REFERENCE_ID=<oauth-client-registration-id>
