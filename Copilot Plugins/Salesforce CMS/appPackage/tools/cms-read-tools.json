    {
      "name": "search_content_cms_channels",
      "description": "Searches published non-media content in public CMS channels by keyword or taxonomy.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "searchKeyword": {
            "type": "string",
            "description": "Up to 10 OR-separated concrete nouns from the request."
          },
          "searchLanguage": {
            "type": "string",
            "description": "Locale such as en_US. Default en_US."
          },
          "channelIds": {
            "type": "string",
            "description": "One or more CMS channel Ids to search."
          },
          "channelType": {
            "type": "string",
            "description": "Limit to channels of this type."
          },
          "contentAccessScope": {
            "type": "string",
            "enum": [
              "Public"
            ],
            "description": "Limit to channels with this access scope."
          },
          "taxonomyExpression": {
            "type": "string",
            "description": "Stringified JSON taxonomy filter, for example {\"OR\":[\"term1\"]}. Use {} if none."
          },
          "contentTypeFqn": {
            "type": "string",
            "description": "One or more content type fully qualified names."
          },
          "pageOffset": {
            "type": "integer",
            "description": "Results page offset."
          },
          "searchLimit": {
            "type": "integer",
            "description": "Maximum items per page."
          }
        }
      },
      "annotations": {
        "title": "Search content cms channels",
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
