    {
      "name": "search_content_cms_workspaces",
      "description": "Searches CMS content in enhanced workspaces and folders by keyword.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "queryTerm": {
            "type": "string",
            "description": "Up to 50 search terms separated by spaces."
          },
          "contentSpaceOrFolderIds": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Workspace or folder Ids to search in."
          },
          "contentTypeFQN": {
            "type": "string",
            "description": "Restrict to this content type."
          },
          "languages": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Up to 10 languages, or All."
          },
          "scope": {
            "type": "string",
            "enum": [
              "All",
              "TitleOnly"
            ],
            "description": "Text search scope. Default All."
          },
          "page": {
            "type": "integer",
            "description": "Page number, starting at 0."
          },
          "pageSize": {
            "type": "integer",
            "description": "Items per page, 1 to 250. Default 25."
          }
        },
        "required": [
          "queryTerm",
          "contentSpaceOrFolderIds"
        ]
      },
      "annotations": {
        "title": "Search content cms workspaces",
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
