    {
      "name": "get_published_cms_content_from_channel",
      "description": "Lists published CMS content in a channel with optional filters and paging.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "channelId": {
            "type": "string",
            "description": "The Id of the CMS channel."
          },
          "contentKeys": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Up to 50 content keys."
          },
          "contentTypeFQN": {
            "type": "string",
            "description": "Fully qualified name of the managed content type."
          },
          "expandReferences": {
            "type": "boolean",
            "description": "Include reference details when true."
          },
          "includeContentBody": {
            "type": "boolean",
            "description": "Return the content body when true."
          },
          "language": {
            "type": "string",
            "description": "Language locale, for example en_US."
          },
          "managedContentIds": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Up to 100 managed content Ids."
          },
          "publishEndDate": {
            "type": "string",
            "description": "ISO 8601 publish end date."
          },
          "publishStartDate": {
            "type": "string",
            "description": "ISO 8601 publish start date."
          },
          "referenceDepth": {
            "type": "integer",
            "description": "Reference depth, 0 to 3."
          },
          "referencesAsList": {
            "type": "boolean",
            "description": "Return references as a list when true."
          },
          "showAbsoluteUrl": {
            "type": "boolean",
            "description": "Return absolute URLs when true."
          },
          "page": {
            "type": "integer",
            "description": "Page number, starting at 0."
          },
          "pageSize": {
            "type": "integer",
            "description": "Items per page, 1 to 250. Default 25."
          }
        },
        "required": [
          "channelId"
        ]
      },
      "annotations": {
        "title": "Get published cms content from channel",
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
