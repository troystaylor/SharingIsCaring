    },
    {
      "name": "get_or_create_cms_workspace_and_web_app_channel",
      "description": "Gets or creates an enhanced CMS workspace and a Web App channel for a UI Bundle, reusing them if they exist.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "developerName": {
            "type": "string",
            "description": "Developer name of the UI Bundle."
          },
          "masterLabel": {
            "type": "string",
            "description": "Human-readable name of the UI Bundle."
          }
        },
        "required": [
          "developerName",
          "masterLabel"
        ]
      },
      "annotations": {
        "title": "Get or create cms workspace and web app channel",
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": false
      }
    }
  ]
}
