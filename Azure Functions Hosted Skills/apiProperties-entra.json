{
  "properties": {
    "connectionParameters": {
      "token": {
        "type": "oauthSetting",
        "oAuthSettings": {
          "identityProvider": "aad",
          "clientId": "[YOUR_CLIENT_ID]",
          "scopes": [
            "[YOUR_FUNCTION_APP_APPLICATION_ID_URI]/user_impersonation"
          ],
          "redirectMode": "Global",
          "redirectUrl": "[YOUR_REDIRECT_URL]",
          "properties": {
            "IsFirstParty": "False"
          },
          "customParameters": {
            "loginUri": {
              "value": "https://login.microsoftonline.com"
            },
            "tenantId": {
              "value": "common"
            },
            "resourceUri": {
              "value": "[YOUR_FUNCTION_APP_APPLICATION_ID_URI]"
            },
            "enableOnbehalfOfLogin": {
              "value": "false"
            }
          }
        }
      },
      "functionAppHost": {
        "type": "string",
        "uiDefinition": {
          "displayName": "Function App Host",
          "description": "Hostname of the function app running your hosted skills.",
          "tooltip": "Enter the hostname only, such as contoso-skills.azurewebsites.net. Do not include https:// or a path.",
          "constraints": {
            "tabIndex": 1,
            "required": "true"
          }
        }
      }
    },
    "iconBrandColor": "#0062AD",
    "capabilities": [],
    "publisher": "Troy Taylor",
    "stackOwner": "Microsoft",
    "scriptOperations": [
      "InvokeSkill",
      "GetSessionHistory",
      "ListSessionWorkflows",
      "GetWorkflowStatus",
      "ListSkills",
      "InvokeMCP"
    ],
    "policyTemplateInstances": [
      {
        "templateId": "dynamichosturl",
        "title": "Set Function App Host",
        "parameters": {
          "x-ms-apimTemplateParameter.urlTemplate": "https://@connectionParameters('functionAppHost')"
        }
      }
    ]
  }
}
