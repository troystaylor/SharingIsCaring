                        "$ref": "#/definitions/PackageAccessEntity"
                    }
                },
                "acquireUsersAndGroups": {
                    "type": "array",
                    "description": "Users and groups that have acquired this package.",
                    "x-ms-summary": "Acquire Users and Groups",
                    "items": {
                        "$ref": "#/definitions/PackageAccessEntity"
                    }
                },
                "sharedWithUsersAndGroups": {
                    "type": "array",
                    "description": "Users and groups the package has been shared with by its owner.",
                    "x-ms-summary": "Shared With Users and Groups",
                    "items": {
                        "$ref": "#/definitions/PackageAccessEntity"
                    }
                },
                "elementDetails": {
                    "type": "array",
                    "description": "Detailed information about each element in the package.",
                    "x-ms-summary": "Element Details",
                    "items": {
                        "$ref": "#/definitions/PackageElementDetail"
                    }
                }
            }
        },
        "PackageAccessEntity": {
            "type": "object",
            "properties": {
                "resourceType": {
                    "type": "string",
                    "description": "Type of resource: user or group.",
                    "x-ms-summary": "Resource Type"
                },
                "resourceId": {
                    "type": "string",
                    "description": "The ID of the user or group.",
                    "x-ms-summary": "Resource ID"
                }
            }
        },
        "PackageElementDetail": {
            "type": "object",
            "properties": {
                "@odata.type": {
                    "type": "string",
                    "description": "OData type of the element detail.",
                    "x-ms-summary": "OData Type"
                }
            }
        },
        "AgentRegistration": {
            "type": "object",
            "required": [
                "displayName"
            ],
            "properties": {
                "id": {
                    "type": "string",
                    "description": "Unique identifier for the agent registration.",
                    "x-ms-summary": "ID",
                    "x-ms-visibility": "advanced"
                },
                "displayName": {
                    "type": "string",
                    "description": "Display name for the agent instance.",
                    "x-ms-summary": "Display Name"
                },
                "description": {
                    "type": "string",
                    "description": "Overview of the agent's purpose and capabilities.",
                    "x-ms-summary": "Description"
                },
                "ownerIds": {
                    "type": "array",
                    "description": "Owner identifiers for the agent. Either owners or Managed By App ID is required.",
                    "x-ms-summary": "Owner IDs",
                    "items": {
                        "type": "string"
                    }
                },
                "createdBy": {
                    "type": "string",
                    "description": "Identifier of the user or app that created the registration. Required on create.",
                    "x-ms-summary": "Created By"
                },
                "sourceCreatedDateTime": {
                    "type": "string",
                    "description": "When the agent instance was created in the source system. Required on create.",
                    "x-ms-summary": "Source Created"
                },
                "sourceLastModifiedDateTime": {
                    "type": "string",
                    "description": "When the agent instance was last modified in the source system. Required on create.",
                    "x-ms-summary": "Source Last Modified"
                },
                "lastPublishedBy": {
