{
    "swagger": "2.0",
    "info": {
        "title": "Copilot Package Management",
        "description": "Manage Microsoft 365 Copilot agents and apps. List, inspect, block, unblock, update, and reassign ownership of packages in your tenant catalog; register agents in the Agent 365 registry; pull Copilot usage reports; and control the Teams meeting limited mode setting. Requires a Microsoft Agent 365 license for package operations.",
        "version": "1.1.0",
        "contact": {
            "name": "Troy Taylor",
            "email": "troy@troystaylor.com"
        }
    },
    "host": "graph.microsoft.com",
    "basePath": "/",
    "schemes": [
        "https"
    ],
    "consumes": [
        "application/json"
    ],
    "produces": [
        "application/json"
    ],
    "paths": {
        "/mcp": {
            "post": {
                "summary": "Invoke Copilot Package Management MCP",
                "description": "Model Context Protocol endpoint for Copilot Studio integration.",
                "operationId": "InvokeMCP",
                "x-ms-agentic-protocol": "mcp-streamable-1.0",
                "responses": {
                    "200": {
                        "description": "MCP response"
                    }
                }
            }
        },
        "/v1.0/copilot/admin/catalog/packages": {
            "get": {
                "operationId": "ListPackages",
                "summary": "List packages",
                "description": "Retrieve a list of all Copilot agents and apps available in the tenant catalog. Supports filtering by supported host, element type, platform, and last modified date.",
                "x-ms-visibility": "important",
                "parameters": [
                    {
                        "name": "$filter",
                        "in": "query",
                        "type": "string",
                        "required": false,
                        "description": "OData filter expression. Filter by supportedHosts (Copilot, Outlook, Teams, M365), elementTypes (Bots, DeclarativeAgent, CustomEngineAgent), platform (Copilot Studio, Microsoft 365 Copilot Agent Builder), or lastModifiedDateTime.",
                        "x-ms-summary": "Filter"
                    },
                    {
                        "name": "$skiptoken",
                        "in": "query",
                        "type": "string",
                        "required": false,
                        "description": "Continuation token from the Next Link of a previous response. Use to retrieve the next page of results.",
                        "x-ms-summary": "Skip Token"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successful response containing packages list.",
                        "schema": {
                            "type": "object",
                            "properties": {
                                "value": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/definitions/CopilotPackage"
                                    }
                                },
                                "@odata.nextLink": {
                                    "type": "string",
                                    "description": "URL for the next page of results. Present only when more results exist.",
                                    "x-ms-summary": "Next Link"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/v1.0/copilot/admin/catalog/packages/{id}": {
            "get": {
                "operationId": "GetPackageDetails",
                "summary": "Get package details",
                "description": "Retrieve detailed information for a specific agent or app by ID, including element details, categories, and access information.",
                "x-ms-visibility": "important",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "type": "string",
                        "description": "The unique identifier of the package.",
                        "x-ms-summary": "Package ID",
                        "x-ms-url-encoding": "single"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successful response containing package details.",
                        "schema": {
                            "$ref": "#/definitions/CopilotPackageDetail"
                        }
                    }
                }
            }
        },
        "/beta/copilot/admin/catalog/packages/{id}": {
            "patch": {
                "operationId": "UpdatePackage",
                "summary": "Update package",
                "description": "Update a package's allowed and acquired users and groups to control availability and deployment.",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "type": "string",
                        "description": "The unique identifier of the package.",
                        "x-ms-summary": "Package ID",
                        "x-ms-url-encoding": "single"
                    },
                    {
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "type": "object",
                            "properties": {
                                "allowedUsersAndGroups": {
                                    "type": "array",
                                    "description": "Users and groups for whom the package is available.",
                                    "x-ms-summary": "Allowed Users and Groups",
                                    "items": {
                                        "$ref": "#/definitions/PackageAccessEntity"
                                    }
                                },
                                "acquireUsersAndGroups": {
                                    "type": "array",
                                    "description": "Users and groups for whom the package is deployed.",
                                    "x-ms-summary": "Acquire Users and Groups",
                                    "items": {
                                        "$ref": "#/definitions/PackageAccessEntity"
                                    }
                                }
                            }
                        }
                    }
                ],
                "responses": {
                    "204": {
                        "description": "Package updated successfully."
                    }
                }
            }
        },
        "/beta/copilot/admin/catalog/packages/{id}/block": {
            "post": {
                "operationId": "BlockPackage",
                "summary": "Block package",
                "description": "Block a Copilot package to prevent its usage across the organization.",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "type": "string",
                        "description": "The unique identifier of the package to block.",
                        "x-ms-summary": "Package ID",
                        "x-ms-url-encoding": "single"
                    }
                ],
                "responses": {
                    "204": {
                        "description": "Package blocked successfully."
                    }
                }
            }
        },
        "/beta/copilot/admin/catalog/packages/{id}/unblock": {
            "post": {
                "operationId": "UnblockPackage",
                "summary": "Unblock package",
                "description": "Unblock a Copilot package to allow its usage across the organization.",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "type": "string",
                        "description": "The unique identifier of the package to unblock.",
                        "x-ms-summary": "Package ID",
                        "x-ms-url-encoding": "single"
                    }
                ],
                "responses": {
                    "204": {
                        "description": "Package unblocked successfully."
                    }
                }
            }
        },
        "/beta/copilot/admin/catalog/packages/{id}/reassign": {
            "post": {
                "operationId": "ReassignPackage",
                "summary": "Reassign package",
                "description": "Reassign ownership of a Copilot package to a different user.",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "type": "string",
                        "description": "The unique identifier of the package to reassign.",
                        "x-ms-summary": "Package ID",
                        "x-ms-url-encoding": "single"
                    },
                    {
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "type": "object",
                            "required": [
                                "userId"
                            ],
                            "properties": {
                                "userId": {
                                    "type": "string",
                                    "description": "The user ID of the new package owner.",
                                    "x-ms-summary": "New Owner User ID"
                                }
                            }
                        }
                    }
                ],
                "responses": {
                    "204": {
                        "description": "Package ownership reassigned successfully."
                    }
                }
            }
        },
        "/beta/copilot/agentRegistrations": {
            "post": {
                "operationId": "CreateAgentRegistration",
                "summary": "Create agent registration",
                "description": "Register an agent in the Agent 365 registry with metadata and an agent card manifest so administrators can discover and govern it.",
                "x-ms-visibility": "important",
                "parameters": [
                    {
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/AgentRegistration"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Agent registration created successfully.",
                        "schema": {
                            "$ref": "#/definitions/AgentRegistration"
                        }
                    }
                }
            }
        },
        "/beta/copilot/agentRegistrations/{id}": {
            "get": {
                "operationId": "GetAgentRegistration",
                "summary": "Get agent registration",
                "description": "Retrieve the properties of a specific agent registration, including its agent card, owners, and identity references.",
                "x-ms-visibility": "important",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "type": "string",
                        "description": "The unique identifier of the agent registration.",
                        "x-ms-summary": "Registration ID",
                        "x-ms-url-encoding": "single"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successful response containing the agent registration.",
                        "schema": {
                            "$ref": "#/definitions/AgentRegistration"
                        }
                    }
                }
            },
            "patch": {
                "operationId": "UpdateAgentRegistration",
                "summary": "Update agent registration",
                "description": "Update properties of an existing agent registration, such as display name, description, owners, or agent card.",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "type": "string",
                        "description": "The unique identifier of the agent registration.",
                        "x-ms-summary": "Registration ID",
                        "x-ms-url-encoding": "single"
                    },
                    {
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/AgentRegistration"
                        }
                    }
                ],
                "responses": {
                    "204": {
                        "description": "Agent registration updated successfully."
                    }
                }
            },
            "delete": {
                "operationId": "DeleteAgentRegistration",
                "summary": "Delete agent registration",
                "description": "Delete an agent registration that is no longer needed.",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "type": "string",
                        "description": "The unique identifier of the agent registration.",
                        "x-ms-summary": "Registration ID",
                        "x-ms-url-encoding": "single"
                    }
                ],
                "responses": {
                    "204": {
                        "description": "Agent registration deleted successfully."
                    }
                }
            }
        },
        "/v1.0/copilot/reports/getMicrosoft365CopilotUserCountSummary(period='{period}',version='{version}')": {
            "get": {
                "operationId": "GetCopilotUserCountSummary",
                "summary": "Get Copilot user count summary",
                "description": "Get the aggregated number of active and enabled Microsoft 365 Copilot users for a time period.",
                "x-ms-visibility": "important",
                "parameters": [
                    {
                        "$ref": "#/parameters/ReportPeriod"
                    },
                    {
                        "$ref": "#/parameters/ReportVersion"
                    },
                    {
                        "$ref": "#/parameters/ReportFormat"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Report content. JSON when $format is application/json, otherwise CSV text.",
                        "schema": {
                            "type": "string",
                            "description": "Report content.",
                            "x-ms-summary": "Report"
                        }
                    }
                }
            }
        },
        "/v1.0/copilot/reports/getMicrosoft365CopilotUserCountTrend(period='{period}',version='{version}')": {
            "get": {
                "operationId": "GetCopilotUserCountTrend",
                "summary": "Get Copilot user count trend",
                "description": "Get the daily trend in active and enabled Microsoft 365 Copilot users for a time period.",
                "x-ms-visibility": "important",
                "parameters": [
                    {
                        "$ref": "#/parameters/ReportPeriod"
                    },
                    {
                        "$ref": "#/parameters/ReportVersion"
                    },
                    {
                        "$ref": "#/parameters/ReportFormat"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Report content. JSON when $format is application/json, otherwise CSV text.",
                        "schema": {
                            "type": "string",
                            "description": "Report content.",
                            "x-ms-summary": "Report"
                        }
                    }
                }
            }
        },
        "/v1.0/copilot/reports/getMicrosoft365CopilotUsageUserDetail(period='{period}',version='{version}')": {
            "get": {
                "operationId": "GetCopilotUsageUserDetail",
                "summary": "Get Copilot usage by user",
                "description": "Get the most recent per-user activity data for Microsoft 365 Copilot apps. Report version v2 includes Copilot Agent Last Activity Date.",
                "x-ms-visibility": "important",
                "parameters": [
                    {
                        "$ref": "#/parameters/ReportPeriod"
                    },
                    {
                        "$ref": "#/parameters/ReportVersion"
                    },
                    {
                        "$ref": "#/parameters/ReportFormat"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Report content. JSON when $format is application/json, otherwise CSV text.",
                        "schema": {
                            "type": "string",
                            "description": "Report content.",
                            "x-ms-summary": "Report"
                        }
                    }
                }
            }
        },
        "/v1.0/copilot/admin/settings/limitedMode": {
            "get": {
                "operationId": "GetLimitedMode",
                "summary": "Get limited mode setting",
                "description": "Read the setting that controls whether Microsoft 365 Copilot in Teams meetings responds to sentiment-related prompts.",
                "responses": {
                    "200": {
                        "description": "Successful response containing the limited mode setting.",
                        "schema": {
                            "$ref": "#/definitions/CopilotAdminLimitedMode"
                        }
                    }
                }
            },
            "patch": {
                "operationId": "UpdateLimitedMode",
                "summary": "Update limited mode setting",
                "description": "Enable or disable limited mode for Microsoft 365 Copilot in Teams meetings, optionally scoped to a Microsoft Entra group.",
                "parameters": [
                    {
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/CopilotAdminLimitedMode"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Setting updated successfully.",
                        "schema": {
                            "$ref": "#/definitions/CopilotAdminLimitedMode"
                        }
                    }
                }
            }
        }
    },
    "parameters": {
        "ReportPeriod": {
            "name": "period",
            "in": "path",
            "required": true,
            "type": "string",
            "default": "D7",
            "enum": [
                "D7",
                "D28",
                "D30",
                "D90",
                "D180",
                "ALL"
            ],
            "description": "Number of previous days to aggregate. Version v1 supports D7, D30, D90, D180, ALL. Version v2 supports D7, D28, D90, D180, ALL.",
            "x-ms-summary": "Period",
            "x-ms-url-encoding": "single"
        },
        "ReportVersion": {
            "name": "version",
            "in": "path",
            "required": true,
            "type": "string",
            "default": "v1",
            "enum": [
                "v1",
                "v2"
            ],
            "description": "Report version. Use v2 for prompt counts and Copilot Agent last activity.",
            "x-ms-summary": "Report Version",
            "x-ms-url-encoding": "single"
        },
        "ReportFormat": {
            "name": "$format",
            "in": "query",
            "required": false,
            "type": "string",
            "default": "application/json",
            "description": "Response format. Omit to receive the raw CSV report.",
            "x-ms-summary": "Format"
        }
    },
    "definitions": {
        "CopilotPackage": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "string",
                    "description": "Unique identifier for the Copilot package.",
                    "x-ms-summary": "ID"
                },
                "displayName": {
                    "type": "string",
                    "description": "Human-readable name of the package.",
                    "x-ms-summary": "Display Name"
                },
                "type": {
                    "type": "string",
                    "description": "Type classification: microsoft, external, shared, or custom.",
                    "x-ms-summary": "Type"
                },
                "shortDescription": {
                    "type": "string",
                    "description": "Brief description of the package.",
                    "x-ms-summary": "Short Description"
                },
                "isBlocked": {
                    "type": "boolean",
                    "description": "Whether the package is administratively blocked.",
                    "x-ms-summary": "Is Blocked"
                },
                "availableTo": {
                    "type": "string",
                    "description": "Availability scope: all, some, or none.",
                    "x-ms-summary": "Available To"
                },
                "deployedTo": {
                    "type": "string",
                    "description": "Deployment scope: all, some, or none.",
                    "x-ms-summary": "Deployed To"
                },
                "lastModifiedDateTime": {
                    "type": "string",
                    "format": "date-time",
                    "description": "Timestamp of the last modification.",
                    "x-ms-summary": "Last Modified"
                },
                "supportedHosts": {
                    "type": "array",
                    "description": "Host applications where this package can be used.",
                    "x-ms-summary": "Supported Hosts",
                    "items": {
                        "type": "string"
                    }
                },
                "elementTypes": {
                    "type": "array",
                    "description": "Element types in this package (bot, declarativeAgent, etc.).",
                    "x-ms-summary": "Element Types",
                    "items": {
                        "type": "string"
                    }
                },
                "publisher": {
                    "type": "string",
                    "description": "Name of the publisher.",
                    "x-ms-summary": "Publisher"
                },
                "platform": {
                    "type": "string",
                    "description": "Host platform (teams, outlook, web).",
                    "x-ms-summary": "Platform"
                },
                "version": {
                    "type": "string",
                    "description": "Version of the package.",
                    "x-ms-summary": "Version"
                },
                "manifestVersion": {
                    "type": "string",
                    "description": "Manifest schema version.",
                    "x-ms-summary": "Manifest Version"
                },
                "manifestId": {
                    "type": "string",
                    "description": "Unique identifier from the manifest.",
                    "x-ms-summary": "Manifest ID"
                },
                "appId": {
                    "type": "string",
                    "description": "Microsoft Entra app registration ID.",
                    "x-ms-summary": "App ID"
                },
                "assetId": {
                    "type": "string",
                    "description": "Asset store reference identifier.",
                    "x-ms-summary": "Asset ID"
                }
            }
        },
        "CopilotPackageDetail": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "string",
                    "description": "Unique identifier for the Copilot package.",
                    "x-ms-summary": "ID"
                },
                "displayName": {
                    "type": "string",
                    "description": "Human-readable name of the package.",
                    "x-ms-summary": "Display Name"
                },
                "type": {
                    "type": "string",
                    "description": "Type classification: microsoft, external, shared, or custom.",
                    "x-ms-summary": "Type"
                },
                "shortDescription": {
                    "type": "string",
                    "description": "Brief description of the package.",
                    "x-ms-summary": "Short Description"
                },
                "longDescription": {
                    "type": "string",
                    "description": "Comprehensive description of the package.",
                    "x-ms-summary": "Long Description"
                },
                "isBlocked": {
                    "type": "boolean",
                    "description": "Whether the package is administratively blocked.",
                    "x-ms-summary": "Is Blocked"
                },
                "availableTo": {
                    "type": "string",
                    "description": "Availability scope: all, some, or none.",
                    "x-ms-summary": "Available To"
                },
                "deployedTo": {
                    "type": "string",
                    "description": "Deployment scope: all, some, or none.",
                    "x-ms-summary": "Deployed To"
                },
                "lastModifiedDateTime": {
                    "type": "string",
                    "format": "date-time",
                    "description": "Timestamp of the last modification.",
                    "x-ms-summary": "Last Modified"
                },
                "supportedHosts": {
                    "type": "array",
                    "description": "Host applications where this package can be used.",
                    "x-ms-summary": "Supported Hosts",
                    "items": {
                        "type": "string"
                    }
                },
                "elementTypes": {
                    "type": "array",
                    "description": "Element types in this package.",
                    "x-ms-summary": "Element Types",
                    "items": {
                        "type": "string"
                    }
                },
                "publisher": {
                    "type": "string",
                    "description": "Name of the publisher.",
                    "x-ms-summary": "Publisher"
                },
                "platform": {
                    "type": "string",
                    "description": "Host platform.",
                    "x-ms-summary": "Platform"
                },
                "version": {
                    "type": "string",
                    "description": "Version of the package.",
                    "x-ms-summary": "Version"
                },
                "manifestVersion": {
                    "type": "string",
                    "description": "Manifest schema version.",
                    "x-ms-summary": "Manifest Version"
                },
                "manifestId": {
                    "type": "string",
                    "description": "Unique identifier from the manifest.",
                    "x-ms-summary": "Manifest ID"
                },
                "appId": {
                    "type": "string",
                    "description": "Microsoft Entra app registration ID.",
                    "x-ms-summary": "App ID"
                },
                "assetId": {
                    "type": "string",
                    "description": "Asset store reference identifier.",
                    "x-ms-summary": "Asset ID"
                },
                "sensitivity": {
                    "type": "string",
                    "description": "Sensitivity classification level.",
                    "x-ms-summary": "Sensitivity"
                },
                "ownerId": {
                    "type": "string",
                    "description": "Object ID of the user who owns the package.",
                    "x-ms-summary": "Owner ID"
                },
                "createdDateTime": {
                    "type": "string",
                    "description": "Date and time the package was created.",
                    "x-ms-summary": "Created"
                },
                "categories": {
                    "type": "array",
                    "description": "Category tags classifying the package.",
                    "x-ms-summary": "Categories",
                    "items": {
                        "type": "string"
                    }
                },
                "allowedUsersAndGroups": {
                    "type": "array",
                    "description": "Users and groups permitted to access this package.",
                    "x-ms-summary": "Allowed Users and Groups",
