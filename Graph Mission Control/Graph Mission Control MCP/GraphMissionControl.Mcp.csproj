<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>GraphMissionControl.Mcp</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <UserSecretsId>fe121f7e-d30c-4d32-8b65-60416cff1f18</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Azure.Monitor.OpenTelemetry.AspNetCore" Version="1.6.0" />
    <PackageReference Include="Microsoft.Identity.Web" Version="4.14.2" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="GraphMissionControl.Mcp.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Linked, not copied. The Power Platform connector embeds the same file, so
         the two heads cannot drift apart. -->
    <EmbeddedResource Include="..\graph-capability-index.json" LogicalName="graph-capability-index.json" />
  </ItemGroup>

</Project>
