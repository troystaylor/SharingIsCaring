{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AzureAd": {
    "Instance": "https://login.microsoftonline.com/",
    "TenantId": "[INSERT_YOUR_TENANT_ID]",
    "ClientId": "[INSERT_YOUR_SERVER_APP_CLIENT_ID]",
    "Audience": "api://[INSERT_YOUR_SERVER_APP_CLIENT_ID]",
    "ClientCredentials": [
      {
        "SourceType": "ClientSecret",
        "ClientSecret": "[SET_VIA_ENVIRONMENT_OR_KEY_VAULT_NOT_HERE]"
      }
    ]
  }
}
