    "MaxResults": 50,
    "AuthMode": "ConnectionString",
    "TokenResource": "",
    "ManagedIdentityClientId": ""
  },
  "Ui": {
    "BaseUrl": "",
    "RequireUrl": true,
    "Collections": {}
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  }
}
